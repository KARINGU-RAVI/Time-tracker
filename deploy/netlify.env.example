# Environment variables to enter in the Netlify UI:
#   Site configuration > Environment variables.  NEVER commit real values.
#
# Scope: choose "Functions" for runtime variables and "Builds" for build-time ones (marked below).

# --- Database (Neon) -------------------------------------------------------------------------------
# The POOLED connection string (host contains "-pooler"), with pgbouncer=true:
DATABASE_URL="postgresql://USER:PASSWORD@HOST-pooler.REGION.aws.neon.tech/DBNAME?sslmode=require&pgbouncer=true&connect_timeout=15"

# --- Sign-in ---------------------------------------------------------------------------------------
AUTH_MODE="google"
ALLOWED_EMAIL="the-one-google-account@example.com"
GOOGLE_CLIENT_ID="1234567890-abc.apps.googleusercontent.com"
# 48+ random characters. Generate with:  node -e "console.log(require('crypto').randomBytes(48).toString('base64'))"
SESSION_SECRET="CHANGE-ME"
# The site address, https, no trailing path:
APP_ORIGIN="https://YOUR-SITE.netlify.app"

# --- Build time (scope: Builds) -----------------------------------------------------------------------
# Baked into the React app so the Google button knows which client to use. Same value as GOOGLE_CLIENT_ID.
VITE_GOOGLE_CLIENT_ID="1234567890-abc.apps.googleusercontent.com"

# --- NOT set in Netlify ----------------------------------------------------------------------------
# DIRECT_URL (the non-pooled Neon address) is only for running migrations from your own computer:
#   put it in backend/.env, never in Netlify.
