# Environment variables to enter in the Netlify UI:
#   Site configuration > Environment variables.  NEVER commit real values.
#
# Scope: choose "Functions" for runtime variables and "Builds" for build-time ones (marked below).

# --- Database (Neon) -------------------------------------------------------------------------------
# The POOLED connection string (host contains "-pooler"). Do NOT add pgbouncer=true (it makes every query 4x slower):
DATABASE_URL="postgresql://USER:PASSWORD@HOST-pooler.REGION.aws.neon.tech/DBNAME?sslmode=require&connect_timeout=15"

# --- Sign-in ---------------------------------------------------------------------------------------
AUTH_MODE="google"
GOOGLE_CLIENT_ID="1234567890-abc.apps.googleusercontent.com"
# 48+ random characters. Generate with:  node -e "console.log(require('crypto').randomBytes(48).toString('base64'))"
SESSION_SECRET="CHANGE-ME"
# The site address, https, no trailing path:
APP_ORIGIN="https://YOUR-SITE.netlify.app"

# --- Email (Brevo, free plan) ----------------------------------------------------------------------
# Verification and password-reset emails. Create a Brevo account, verify a sender address, make an API key.
BREVO_API_KEY="xkeysib-CHANGE-ME"
# The verified sender address (the "from" of every email):
EMAIL_FROM="you@example.com"

# --- Abuse protection ---------------------------------------------------------------------------------
# Cloudflare Turnstile (free) SECRET key, used by the server to check the "are you human" widget:
TURNSTILE_SECRET_KEY="CHANGE-ME"
# Sign-ups stop at this many accounts (protects the free database). Optional, default 200:
MAX_ACCOUNTS="200"

# --- Build time (scope: Builds) -----------------------------------------------------------------------
# Baked into the React app so the Google button knows which client to use. Same value as GOOGLE_CLIENT_ID.
VITE_GOOGLE_CLIENT_ID="1234567890-abc.apps.googleusercontent.com"
# Turnstile SITE key (public), for the widget on the sign-up and reset forms:
VITE_TURNSTILE_SITE_KEY="0x4AAAAAAA-CHANGE-ME"

# --- NOT set in Netlify ----------------------------------------------------------------------------
# DIRECT_URL (the non-pooled Neon address) is only for running migrations from your own computer:
#   put it in backend/.env, never in Netlify.
