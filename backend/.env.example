# Copy to .env and fill in. Never commit .env.

# ---- Database ---------------------------------------------------------------
# Local development database (a throwaway PostgreSQL)
DATABASE_URL="postgresql://postgres@127.0.0.1:5544/oht_dev"
# Used by migrations. Locally it is the same address; on Neon it is the DIRECT (non-pooled) one.
DIRECT_URL="postgresql://postgres@127.0.0.1:5544/oht_dev"

# Production (Neon): the pooled URL for the app, the direct URL for migrations.
# DATABASE_URL="postgresql://USER:PASSWORD@HOST-pooler.neon.tech/DB?sslmode=require&pgbouncer=true&connect_timeout=15"
# DIRECT_URL="postgresql://USER:PASSWORD@HOST.neon.tech/DB?sslmode=require"

# ---- The one person allowed to use the app ---------------------------------
ALLOWED_EMAIL="owner@example.com"

# First day hours are tracked from (YYYY-MM-DD). Earlier leave comes from the opening balance.
SEED_TRACKING_START="2026-09-21"

# ---- Sign-in ----------------------------------------------------------------
# dev    = every request is the owner. LOCAL ONLY. The server refuses to start in production.
# google = Google sign-in with a signed HttpOnly session cookie.
AUTH_MODE="dev"

# Needed when AUTH_MODE=google:
# GOOGLE_CLIENT_ID="1234567890-abc.apps.googleusercontent.com"
# SESSION_SECRET="at least 32 random characters, e.g. from: openssl rand -base64 48"
# APP_ORIGIN="https://your-site.netlify.app"
