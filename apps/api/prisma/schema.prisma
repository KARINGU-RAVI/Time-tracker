// Office Hours Tracker: data model.
//
// Principles (see docs/01-domain-screens-er.md, section 3):
//  - Store raw facts only: sessions, day status, rules, holidays, ledger entries.
//  - Worked time, balances, overtime and leave usage are derived by @oht/engine.
//  - The database itself enforces the rules Prisma cannot express (overlap, one open
//    session, OUT after IN, rule overlap ...). See the raw SQL in the migrations.

generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "rhel-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum AttendanceStatus {
  WORKING
  WFH
  CASUAL_LEAVE
  SICK_LEAVE
  BEREAVEMENT_LEAVE
  OPTIONAL_HOLIDAY
}

enum HolidayType {
  COMPANY
  OPTIONAL
}

enum LeavePool {
  ANNUAL
  OPTIONAL
  BEREAVEMENT
}

enum LedgerEntryType {
  OPENING
  ACCRUAL
  GRANT
  LAPSE
  ADJUSTMENT
}

model User {
  id         String   @id @default(uuid()) @db.Uuid
  email      String   @unique
  googleSub  String?  @unique
  name       String?
  timezone   String   @default("Asia/Kolkata")
  createdAt  DateTime @default(now()) @db.Timestamptz(6)

  settings          UserSettings?
  attendances       Attendance[]
  sessions          AttendanceSession[]
  workRules         WorkRule[]
  holidays          Holiday[]
  leavePolicies     LeavePolicy[]
  ledgerEntries     LeaveLedgerEntry[]
  bereavementEvents BereavementEvent[]
  auditLogs         AuditLog[]
}

model UserSettings {
  userId            String   @id @db.Uuid
  /** Days before this date are never counted. */
  trackingStartDate DateTime @db.Date
  /** Longest allowed single session, in minutes (default 16h). */
  maxSessionMinutes Int      @default(960)
  theme             String   @default("system")
  notificationPrefs Json     @default("{}")
  updatedAt         DateTime @updatedAt @db.Timestamptz(6)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

/// One record per user per day, created only when the user records something for that date.
/// Holiday and weekly-off days are derived from Holiday and WorkRule, never stored here.
model Attendance {
  id                  String           @id @default(uuid()) @db.Uuid
  userId              String           @db.Uuid
  /** IST calendar date this record belongs to. */
  date                DateTime         @db.Date
  status              AttendanceStatus @default(WORKING)
  /** 1.0 for a full day, 0.5 for a half-day leave. */
  dayFraction         Decimal          @default(1.0) @db.Decimal(2, 1)
  bereavementEventId  String?          @db.Uuid
  /** User told their manager (used when leave will be unpaid). */
  managerInformed     Boolean          @default(false)
  notes               String?
  createdAt           DateTime         @default(now()) @db.Timestamptz(6)
  updatedAt           DateTime         @updatedAt @db.Timestamptz(6)

  user              User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  bereavementEvent  BereavementEvent?  @relation(fields: [bereavementEventId], references: [id], onDelete: SetNull)
  sessions          AttendanceSession[]

  @@unique([userId, date])
  @@index([userId, date])
}

model AttendanceSession {
  id           String    @id @default(uuid()) @db.Uuid
  attendanceId String    @db.Uuid
  /// Denormalised from Attendance so the database can prevent overlaps across all of a user's sessions.
  userId       String    @db.Uuid
  inTime       DateTime  @db.Timestamptz(6)
  /// Null while the session is still open.
  outTime      DateTime? @db.Timestamptz(6)
  createdAt    DateTime  @default(now()) @db.Timestamptz(6)
  updatedAt    DateTime  @updatedAt @db.Timestamptz(6)

  attendance Attendance @relation(fields: [attendanceId], references: [id], onDelete: Cascade)
  user       User       @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([attendanceId])
  @@index([userId, inTime])
}

/// Effective-dated, versioned work rule. Changing a rule closes the old one and creates a new one.
model WorkRule {
  id                     String    @id @default(uuid()) @db.Uuid
  userId                 String    @db.Uuid
  dailyRequiredMinutes   Int
  weeklyRequiredMinutes  Int
  halfDayRequiredMinutes Int
  /// ISO weekdays that are working days: 1 = Monday ... 7 = Sunday.
  workingDays            Int[]
  weekStartsOn           Int       @default(1)
  effectiveFrom          DateTime  @db.Date
  /// Inclusive end date; null means open-ended.
  effectiveTo            DateTime? @db.Date
  createdAt              DateTime  @default(now()) @db.Timestamptz(6)
  updatedAt              DateTime  @updatedAt @db.Timestamptz(6)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, effectiveFrom])
}

model Holiday {
  id          String      @id @default(uuid()) @db.Uuid
  userId      String      @db.Uuid
  date        DateTime    @db.Date
  name        String
  type        HolidayType @default(COMPANY)
  description String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, date])
  @@index([userId, date])
}

model LeavePolicy {
  id                      String    @id @default(uuid()) @db.Uuid
  userId                  String    @db.Uuid
  annualEntitlement       Decimal   @db.Decimal(5, 2)
  accrualPerMonth         Decimal   @db.Decimal(5, 2)
  carryForwardCap         Decimal   @db.Decimal(5, 2)
  optionalQuota           Decimal   @db.Decimal(5, 2)
  bereavementDaysPerEvent Int
  effectiveFrom           DateTime  @db.Date
  effectiveTo             DateTime? @db.Date

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, effectiveFrom])
}

/// Holds only what cannot be derived: opening balance, accruals, grants, lapses, adjustments.
/// Leave USAGE is derived from Attendance rows, so the two can never disagree.
model LeaveLedgerEntry {
  id            String          @id @default(uuid()) @db.Uuid
  userId        String          @db.Uuid
  pool          LeavePool
  type          LedgerEntryType
  /// Signed days.
  days          Decimal         @db.Decimal(5, 2)
  effectiveDate DateTime        @db.Date
  leaveYear     Int
  note          String?
  createdAt     DateTime        @default(now()) @db.Timestamptz(6)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, pool, effectiveDate])
}

/// Bereavement leave is granted per event (up to 5 days), not accrued.
model BereavementEvent {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @db.Uuid
  relation  String
  startDate DateTime @db.Date
  note      String?
  createdAt DateTime @default(now()) @db.Timestamptz(6)

  user        User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  attendances Attendance[]

  @@index([userId, startDate])
}

/// Before/after snapshots of edits and deletions, so "why did Tuesday change?" is answerable.
model AuditLog {
  id       String   @id @default(uuid()) @db.Uuid
  userId   String   @db.Uuid
  entity   String
  entityId String   @db.Uuid
  action   String
  before   Json?
  after    Json?
  at       DateTime @default(now()) @db.Timestamptz(6)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, at])
  @@index([entity, entityId])
}
