# Copy to .env and fill in. Never commit .env.

# Local development database (a throwaway PostgreSQL)
DATABASE_URL="postgresql://postgres@127.0.0.1:5544/oht_dev"

# Production (Neon): use the pooled URL for the app, the direct URL for migrations.
# DATABASE_URL="postgresql://USER:PASSWORD@HOST-pooler.neon.tech/DB?sslmode=require&pgbouncer=true&connect_timeout=15"
# DIRECT_URL="postgresql://USER:PASSWORD@HOST.neon.tech/DB?sslmode=require"

# The single Google account allowed to sign in (used by the seed and by auth later).
ALLOWED_EMAIL="owner@example.com"

# First day hours are tracked from (YYYY-MM-DD). Earlier leave comes from the opening balance.
SEED_TRACKING_START="2026-09-21"
